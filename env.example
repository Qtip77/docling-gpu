# ============================================
# Mistral Azure MaaS Configuration
# ============================================
MISTRAL_AZURE_ENDPOINT=https://your-mistral.inference.ai.azure.com
MISTRAL_AZURE_API_KEY=your-key

# ============================================
# OCR Processing Configuration
# ============================================
# Number of pages to process per OCR API call (default: 10)
OCR_PAGE_BATCH_SIZE=10

# Max concurrent OCR requests per document (default: 5)
OCR_MAX_CONCURRENT=5

# Timeout for OCR requests in seconds (default: 120)
OCR_TIMEOUT=120

# ============================================
# Document Processing Configuration
# ============================================
# Max documents to process simultaneously (default: 5)
MAX_CONCURRENT_DOCS=5

# ============================================
# Embedding Configuration
# ============================================
# Texts per embedding API call (default: 500, max: 2048)
EMBEDDING_BATCH_SIZE=500

# Max concurrent embedding requests (default: 4)
EMBEDDING_MAX_CONCURRENT=4

# ============================================
# Azure AI Search Configuration
# ============================================
AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_SEARCH_KEY=your-admin-key
AZURE_SEARCH_INDEX_NAME=docling-rag

# Chunks per upload batch (default: 1000, max: 1000)
SEARCH_UPLOAD_BATCH_SIZE=1000

# Max concurrent upload batches (default: 3)
SEARCH_MAX_CONCURRENT=3

# ============================================
# Azure OpenAI Configuration
# ============================================
AZURE_OPENAI_ENDPOINT=https://your-openai.openai.azure.com
AZURE_OPENAI_API_KEY=your-api-key
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_MODEL=gpt-4o
AZURE_OPENAI_EMBEDDINGS=text-embedding-3-large
AZURE_OPENAI_EMBEDDINGS_MODEL=text-embedding-3-large

# ============================================
# LangGraph Multi-Agent RAG Configuration
# ============================================
AZURE_OPENAI_ORCHESTRATOR_DEPLOYMENT=gpt-4o
AZURE_OPENAI_ANALYST_DEPLOYMENT=gpt-4o-mini

# Temperature settings (use 'default' for model defaults)
AZURE_OPENAI_ORCHESTRATOR_TEMPERATURE=default
AZURE_OPENAI_ANALYST_TEMPERATURE=default

# LangGraph Server (auto-configured in Docker)
REDIS_URI=redis://langgraph-redis:6379
DATABASE_URI=postgres://langgraph:langgraph@langgraph-postgres:5432/langgraph?sslmode=disable

# ============================================
# LangSmith (Optional - for tracing)
# ============================================
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=lsv2_...
LANGCHAIN_PROJECT=multi-agent-rag
